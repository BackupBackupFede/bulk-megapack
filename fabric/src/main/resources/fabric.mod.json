{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Shift-click a station result and it keeps going until your stack runs out: villager trades, stonecutter, loom, cartography table, plus sneak + right-click to empty a stack into a composter. No rule is changed.",
  "authors": ["${mod_author}"],
  "contact": {
    "homepage": "https://github.com/BackupBackupFede/${mod_repo}",
    "issues": "https://github.com/BackupBackupFede/${mod_repo}/issues"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["net.emeraude.bulkmegapack.fabric.BulkMegapackFabric"],
    "client": ["net.emeraude.bulkmegapack.fabric.BulkMegapackFabricClient"]
  },
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "minecraft": "${fabric_mc_dep}",
    "fabricloader": ">=0.16"
  }
}
